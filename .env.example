# Published QuickML prediction endpoint URL.
QUICKML_ENDPOINT_URL=PASTE_ENDPOINT_URL_HERE
# QuickML endpoint key sent in X-QUICKML-ENDPOINT-KEY.
QUICKML_ENDPOINT_KEY=PASTE_ENDPOINT_KEY_HERE
# QuickML authorization value sent exactly as provided.
QUICKML_AUTH=PASTE_AUTH_VALUE_HERE
# Zoho Accounts base URL used for OAuth token refresh.
ZOHO_ACCOUNTS_URL=PASTE_ZOHO_ACCOUNTS_URL_HERE
# OAuth client ID for refreshing the QuickML authorization token.
ZOHO_CLIENT_ID=PASTE_ZOHO_CLIENT_ID_HERE
# OAuth client secret for refreshing the QuickML authorization token.
ZOHO_CLIENT_SECRET=PASTE_ZOHO_CLIENT_SECRET_HERE
# OAuth refresh token for refreshing the QuickML authorization token.
ZOHO_REFRESH_TOKEN=PASTE_ZOHO_REFRESH_TOKEN_HERE
# Catalyst organization identifier.
CATALYST_ORG=PASTE_CATALYST_ORG_HERE
# Catalyst environment name.
CATALYST_ENVIRONMENT=PASTE_ENVIRONMENT_HERE
# AppSail listens on this Catalyst-provided port.
X_ZOHO_CATALYST_LISTEN_PORT=9000

# Deployment names injected into Catalyst app-config.json.
HS_QML_URL=PASTE_ENDPOINT_URL_HERE
HS_QML_KEY=PASTE_ENDPOINT_KEY_HERE
HS_ORG_ID=PASTE_CATALYST_ORG_HERE
HS_ENV_NAME=PASTE_ENVIRONMENT_HERE
HS_OAUTH_ID=PASTE_ZOHO_CLIENT_ID_HERE
HS_OAUTH_SECRET=PASTE_ZOHO_CLIENT_SECRET_HERE
HS_OAUTH_REFRESH=PASTE_ZOHO_REFRESH_TOKEN_HERE
HS_OAUTH_URL=PASTE_ZOHO_ACCOUNTS_URL_HERE
